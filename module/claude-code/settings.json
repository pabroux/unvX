{
  "permissions": {
    "deny": [
      "Edit(**/.env)",
      "Read(**/.env)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["**/.env", "**/.env.*", "**/.ssh/**"]
    }
  },
  "tui": "fullscreen",
  "voiceEnabled": true
}
