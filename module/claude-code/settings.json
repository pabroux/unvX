{
  "effortLevel": "medium",
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/sulfyderz/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "deny": [
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(~/.ssh/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/.ssh/**)"
    ]
  },
  "sandbox": {
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        }
      ]
    },
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "/**/.env",
        "/**/.env.*"
      ]
    }
  },
  "tui": "fullscreen",
  "voiceEnabled": true
}
