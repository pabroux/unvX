{
  "effortLevel": "medium",
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/sulfyderz/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "deny": [
      "Edit(**/.env)",
      "Read(**/.env)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "**/.env",
        "**/.env.*",
        "**/.ssh/**"
      ]
    }
  },
  "tui": "fullscreen",
  "voiceEnabled": true
}
