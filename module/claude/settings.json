{
  "permissions": {
    "deny": [
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(~/.ssh/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/.ssh/**)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/sulfyderz/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "/**/.env",
        "/**/.env.*"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        }
      ]
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoMode": {
    "environment": [
      "$defaults"
    ]
  },
  "voiceEnabled": true
}
